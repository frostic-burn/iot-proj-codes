<script>
// ─── Audio unlock ────────────────────────────────────────────────────────────
// Browsers block audio until a user gesture. We create the AudioContext only
// after the user taps the button, which counts as a gesture.
// ─────────────────────────────────────────────────────────────────────────────
let audioCtx   = null;
let audioReady = false;   // true after user taps to unlock
let muted      = false;
let alarmTimer = null;
let alarmOn    = false;

function unlockAudio() {
  // Create context on a real user-gesture click
  audioCtx   = new (window.AudioContext || window.webkitAudioContext)();
  audioReady = true;

  // Play a silent beep so the context is fully resumed
  const osc = audioCtx.createOscillator();
  const g   = audioCtx.createGain();
  g.gain.setValueAtTime(0, audioCtx.currentTime);
  osc.connect(g); g.connect(audioCtx.destination);
  osc.start(); osc.stop(audioCtx.currentTime + 0.001);

  // Switch button to Mute mode
  const btn = document.getElementById('actionBtn');
  btn.className   = 'mute';
  btn.innerHTML   = '<span>🔇</span> Mute Alarm';
}

function handleBtn() {
  if (!audioReady) {
    unlockAudio();
    return;
  }
  // Toggle mute
  muted = !muted;
  const btn = document.getElementById('actionBtn');
  if (muted) {
    btn.className = 'unmute';
    btn.innerHTML = '<span>🔔</span> Unmute Alarm';
    stopAlarm();
  } else {
    btn.className = 'mute';
    btn.innerHTML = '<span>🔇</span> Mute Alarm';
    if (alarmOn) scheduleBeep(); // resume if fire still active
  }
}

// ─── Beep generator ───────────────────────────────────────────────────────────
function playBeep() {
  if (!audioReady || muted || !audioCtx) return;

  // Two-tone fire alarm: alternating 880 Hz / 1100 Hz square waves
  [[880, 0], [1100, 0.22]].forEach(([freq, delay]) => {
    const osc  = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    const t    = audioCtx.currentTime + delay;

    osc.type = 'square';
    osc.frequency.setValueAtTime(freq, t);

    gain.gain.setValueAtTime(0, t);
    gain.gain.linearRampToValueAtTime(0.3,  t + 0.01);
    gain.gain.setValueAtTime(0.3,  t + 0.17);
    gain.gain.linearRampToValueAtTime(0,    t + 0.21);

    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(t);
    osc.stop(t + 0.22);
  });
}

function scheduleBeep() {
  playBeep();
  alarmTimer = setTimeout(scheduleBeep, 900);
}

function startAlarm() {
  if (alarmOn) return;
  alarmOn = true;
  scheduleBeep();
}

function stopAlarm() {
  alarmOn = false;
  clearTimeout(alarmTimer);
}

// ─── UI update ───────────────────────────────────────────────────────────────
function setStatus(fire) {
  const card   = document.getElementById('card');
  const iw     = document.getElementById('iconWrap');
  const label  = document.getElementById('label');
  const sub    = document.getElementById('sub');
  const pill   = document.getElementById('pill');
  const pt     = document.getElementById('pillText');
  const banner = document.getElementById('alertBanner');

  if (fire) {
    card.className  = 'card fire';
    iw.className    = 'icon-wrap fire';
    iw.textContent  = '🔥';
    label.className = 'status-label fire';
    label.textContent = 'FIRE!';
    sub.textContent = 'Flame detected — take action now!';
    pill.className  = 'pill fire';
    pt.textContent  = 'Alarm Active';
    banner.classList.add('visible');
    startAlarm();
  } else {
    card.className  = 'card safe';
    iw.className    = 'icon-wrap safe';
    iw.textContent  = '🛡️';
    label.className = 'status-label safe';
    label.textContent = 'All Clear';
    sub.textContent = 'No flame detected by sensor';
    pill.className  = 'pill safe';
    pt.textContent  = 'System Normal';
    banner.classList.remove('visible');
    stopAlarm();
  }

  document.getElementById('ts').textContent = new Date().toLocaleTimeString();
}

// ─── Polling ─────────────────────────────────────────────────────────────────
async function poll() {
  try {
    const res  = await fetch('/status');
    const data = await res.json();
    setStatus(data.fire);
  } catch(e) {
    console.warn('Poll error:', e);
  }
}

poll();
setInterval(poll, 1000);
</script>
