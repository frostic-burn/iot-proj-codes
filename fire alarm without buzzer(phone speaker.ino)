/*
 * 🔥 Fire Alarm Web Server
 * ESP32 / ESP8266 - Flame Sensor + Browser Alarm
 *
 * When fire is detected, the web page plays a buzzer alarm sound
 * and shows a live alert. Auto-refreshes every second.
 *
 * Wiring:
 *   Flame Sensor OUT → GPIO 5
 *   Flame Sensor VCC → 3.3V
 *   Flame Sensor GND → GND
 */

// ─────────────────────────────────────────────
//  Board Detection
// ─────────────────────────────────────────────
#ifdef ESP8266
  #include <ESP8266WiFi.h>
  #include <ESP8266WebServer.h>
  ESP8266WebServer server(80);
#else
  #include <WiFi.h>
  #include <WebServer.h>
  WebServer server(80);
#endif

// ─────────────────────────────────────────────
//  Config
// ─────────────────────────────────────────────
const char* ssid     = "wifi";      // ← your WiFi SSID
const char* password = "password";  // ← your WiFi password

#define FLAME_PIN 5   // GPIO connected to flame sensor OUT

