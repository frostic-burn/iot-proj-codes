void setup() {
  Serial.begin(9600);
  delay(1000);
  Serial.println("🔋 Booting up...");
  
  // Connect to Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("📶 Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n✅ WiFi Connected!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.localIP());
  
  // Setup web server routes
  server.on("/", HTTP_GET, handleRoot);
  server.on("/data", HTTP_GET, handleData);
  
  // Start server
  server.begin();
  Serial.println("✅ Web server started!");
}

void loop() {
  server.handleClient();
  
  // Read sensor at intervals
  unsigned long currentTime = millis();
  if (currentTime - lastReadingTime >= readingInterval) {
    lastReadingTime = currentTime;
    updateWaterLevel();
  }
}

void updateWaterLevel() {
  float distanceCm = distanceSensor.measureDistanceCm();
  
  // Clamp bad readings
  if (distanceCm <= 0 || isnan(distanceCm)) {
    Serial.println("⚠ Sensor error or invalid reading.");
    return;
  }
  
  if (distanceCm > maxDistance) {
    distanceCm = maxDistance;
  }
  
  waterLevelPercent = ((maxDistance - distanceCm) / maxDistance) * 100.0;
  
  // Clamp to 0-100%
  waterLevelPercent = constrain(waterLevelPercent, 0, 100);
  
  Serial.print("💧 Water Level: ");
  Serial.print(waterLevelPercent, 1); // 1 decimal place
  Serial.println("%");
  Serial.print("📏 Distance: ");
  Serial.print(distanceCm, 1);
  Serial.println(" cm");
}

void handleRoot() {
  // Replace placeholders in the HTML template
  String html = String(index_html);
  html.replace("%MAX_DISTANCE%", String(maxDistance));
  server.send(200, "text/html", html);
}

void handleData() {
  // Create a JSON response with water level data
  float distanceCm = distanceSensor.measureDistanceCm();
  if (distanceCm <= 0 || isnan(distanceCm)) {
    distanceCm = maxDistance;
  }
  if (distanceCm > maxDistance) {
    distanceCm = maxDistance;
  }
  
  String json = "{";
  json += "\"waterLevel\":" + String(waterLevelPercent, 1) + ",";
  json += "\"distance\":" + String(distanceCm, 1) + ",";
  json += "\"maxDistance\":" + String(maxDistance);
  json += "}";
  
  server.send(200, "application/json", json);
}
