#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// WiFi credentials
const char* ssid = "wifi";
const char* password = "password";

// Servo pins
#define PAN_PIN 5   // GPIO 5 for pan servo
#define TILT_PIN 18 // GPIO 18 for tilt servo

Servo panServo;
Servo tiltServo;

int panAngle = 90;   // Initial pan position (center)
int tiltAngle = 90;  // Initial tilt position (center)

WebServer server(80);

