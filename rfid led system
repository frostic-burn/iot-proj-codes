#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN 5
#define RST_PIN 22

MFRC522 rfid(SS_PIN, RST_PIN);

// LED pins
#define GREEN_LED 2
#define RED_LED 4

// ✅ YOUR CARD UID (UPDATED HERE)
byte authorizedUID[4] = {0x6C, 0xAE, 0x0F, 0x05};

void setup() {
  Serial.begin(115200);
  SPI.begin();
  rfid.PCD_Init();

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, LOW);

  Serial.println("Scan your card...");
}

void loop() {
  // Wait for card
  if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial()) {
    return;
  }

  Serial.print("UID: ");

  // Print UID properly (with leading zeros)
  for (byte i = 0; i < rfid.uid.size; i++) {
    if (rfid.uid.uidByte[i] < 0x10) Serial.print("0");
    Serial.print(rfid.uid.uidByte[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Compare UID
  bool match = true;

  if (rfid.uid.size != 4) {
    match = false;
  } else {
    for (byte i = 0; i < 4; i++) {
      if (rfid.uid.uidByte[i] != authorizedUID[i]) {
        match = false;
      }
    }
  }

  // LED Logic
  if (match) {
    Serial.println("✅ Access Granted");
    digitalWrite(GREEN_LED, HIGH);
    digitalWrite(RED_LED, LOW);
  } else {
    Serial.println("❌ Access Denied");
    digitalWrite(RED_LED, HIGH);
    digitalWrite(GREEN_LED, LOW);
  }

  delay(2000);

  // Turn off LEDs after 2 sec
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, LOW);

  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
}
