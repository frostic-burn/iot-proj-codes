// ── Web Routes ────────────────────────────────────────
void handleRoot() {
  server.send(200, "text/html", buildDashboard());
}

void handlePumpOn() {
  manualPump = true;
  pumpState  = true;
  digitalWrite(RELAY_PUMP_PIN, LOW);
  server.sendHeader("Location", "/");
  server.send(303);
}

void handlePumpOff() {
  manualPump      = false;
  pumpState       = false;
  pumpCycleActive = false;
  digitalWrite(RELAY_PUMP_PIN, HIGH);
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleData() {
  String json = "{";
  json += "\"temperature\":"  + String(temperature, 1)  + ",";
  json += "\"humidity\":"     + String(humidity, 1)     + ",";
  json += "\"gas\":"          + String(gasLevel)        + ",";
  json += "\"gasAlert\":"     + String(gasAlert      ? "true" : "false") + ",";
  json += "\"pump\":"         + String(pumpState     ? "true" : "false") + ",";
  json += "\"proximity\":"    + String(proximityAlert ? "true" : "false") + ",";
  json += "\"distance\":"     + String(lastDistance, 1);
  json += "}";
  server.send(200, "application/json", json);
}

// ── Setup ────────────────────────────────────────────
void setup() {
  Serial.begin(115200);

  pinMode(RELAY_PUMP_PIN, OUTPUT);
  pinMode(BUZZER_PIN,     OUTPUT);
  pinMode(TRIG_PIN,       OUTPUT);
  pinMode(ECHO_PIN,       INPUT);

  digitalWrite(RELAY_PUMP_PIN, HIGH); // Pump OFF
  digitalWrite(BUZZER_PIN,     LOW);  // Buzzer OFF
  digitalWrite(TRIG_PIN,       LOW);

  dht.begin();

  WiFi.begin(ssid, password);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500); Serial.print(".");
  }
  Serial.println("\nConnected! IP: " + WiFi.localIP().toString());
  Serial.println("Dashboard → http://" + WiFi.localIP().toString() + "/");

  server.on("/",         handleRoot);
  server.on("/pump/on",  handlePumpOn);
  server.on("/pump/off", handlePumpOff);
  server.on("/data",     handleData);
  server.begin();

  lastPumpTime = millis();
}

// ── Loop ─────────────────────────────────────────────
void loop() {
  server.handleClient();
  unsigned long now = millis();

  // --- Read DHT11 ---
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (!isnan(t)) temperature = t;
  if (!isnan(h)) humidity    = h;

  // --- Read MQ2 ---
  gasLevel = analogRead(MQ2_PIN);
  gasAlert = (gasLevel > GAS_THRESHOLD);

  // --- Read HC-SR04 ---
  lastDistance   = getDistanceCM();
  proximityAlert = (lastDistance < PROXIMITY_CM);

  // --- Proximity: beep 3 times (with cooldown so it doesn't repeat every loop) ---
  if (proximityAlert && (now - lastBuzzerTime >= BUZZER_COOLDOWN_MS)) {
    lastBuzzerTime = now;
    Serial.printf("[PROXIMITY] Hand detected at %.1f cm — beeping!\n", lastDistance);
    beepThreeTimes();
  }

  // --- Gas Alert: fast continuous beep (only if no proximity beep happening) ---
  if (gasAlert && !proximityAlert) {
    digitalWrite(BUZZER_PIN, (now / 300) % 2 == 0 ? HIGH : LOW);
  }

  // --- Stop buzzer if no alerts ---
  if (!gasAlert && !proximityAlert) {
    digitalWrite(BUZZER_PIN, LOW);
  }

  // --- Auto Pump: every 5 min, runs 10 seconds ---
  if (!manualPump) {
    if (!pumpCycleActive && (now - lastPumpTime >= PUMP_INTERVAL_MS)) {
      pumpCycleActive = true;
      pumpStartTime   = now;
      pumpState       = true;
      digitalWrite(RELAY_PUMP_PIN, LOW);
      Serial.println("[PUMP] Auto cycle started.");
    }
    if (pumpCycleActive && (now - pumpStartTime >= PUMP_ON_DURATION)) {
      pumpCycleActive = false;
      pumpState       = false;
      lastPumpTime    = now;
      digitalWrite(RELAY_PUMP_PIN, HIGH);
      Serial.println("[PUMP] Auto cycle done.");
    }
  }

  Serial.printf("[SHED] T:%.1f°C H:%.1f%% Gas:%d Dist:%.1fcm Pump:%s\n",
    temperature, humidity, gasLevel, lastDistance,
    pumpState ? "ON" : "OFF");

  delay(500); // 500ms loop — fast enough for responsive proximity detection
}
