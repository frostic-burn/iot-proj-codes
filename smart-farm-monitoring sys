
#include <WiFi.h>
#include <WebServer.h>
#include <DHT.h>

// ── Credentials ──────────────────────────────────────
const char* ssid     = "wifi";
const char* password = "password";

// ── Pin Definitions ──────────────────────────────────
#define MQ2_PIN          34   // Analog input
#define DHT_PIN          4    // DHT11 data pin
#define DHT_TYPE         DHT11
#define RELAY_PUMP_PIN   26   // GPIO26 → Relay IN (Pump)
#define BUZZER_PIN       25   // GPIO25 → Buzzer
#define TRIG_PIN         13   // HC-SR04 Trigger
#define ECHO_PIN         12   // HC-SR04 Echo

// ── Thresholds ────────────────────────────────────────
#define GAS_THRESHOLD       1500   // Raw ADC — tune for your environment
#define PROXIMITY_CM        10     // Hand detected if distance < 10 cm
#define PUMP_INTERVAL_MS    300000UL  // 5 minutes
#define PUMP_ON_DURATION    10000UL   // Pump ON for 10 seconds per cycle
#define BUZZER_COOLDOWN_MS  3000UL    // Min gap between proximity beep triggers

// ── Objects ──────────────────────────────────────────
DHT       dht(DHT_PIN, DHT_TYPE);
WebServer server(80);

// ── State ────────────────────────────────────────────
float    temperature      = 0;
float    humidity         = 0;
int      gasLevel         = 0;
bool     gasAlert         = false;
bool     pumpState        = false;
bool     proximityAlert   = false;
bool     manualPump       = false;
float    lastDistance     = 999;

unsigned long lastPumpTime      = 0;
unsigned long pumpStartTime     = 0;
unsigned long lastBuzzerTime    = 0;
bool          pumpCycleActive   = false;

// ── HC-SR04 Distance Reading ─────────────────────────
float getDistanceCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000); // 30ms timeout
  if (duration == 0) return 999; // no echo = out of range
  return (duration * 0.0343) / 2.0;
}

// ── Buzzer: 3 Short Beeps ────────────────────────────
void beepThreeTimes() {
  for (int i = 0; i < 3; i++) {
    digitalWrite(BUZZER_PIN, HIGH); delay(150);
    digitalWrite(BUZZER_PIN, LOW);  delay(150);
  }
}

